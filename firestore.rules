rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model: the NestJS portal writes ssoAccess and compatibility users.
    // Client sessions are custom-token sessions with claims bound to that projection.
    function signedIn() {
      return request.auth != null;
    }

    function hasV2RabClaim() {
      return signedIn()
        && request.auth.token.portalAccess == true
        && request.auth.token.appId == 'rab-calc'
        && request.auth.token.ssoVersion == 2
        && request.auth.token.centralUid is string
        && request.auth.token.grantVersion is number;
    }

    function accessPath() {
      return /databases/$(database)/documents/ssoAccess/$(request.auth.uid);
    }

    function hasPortalSession() {
      return hasV2RabClaim()
        && exists(accessPath())
        && get(accessPath()).data.enabled == true
        && get(accessPath()).data.appId == 'rab-calc'
        && get(accessPath()).data.centralUid == request.auth.token.centralUid
        && get(accessPath()).data.grantVersion == request.auth.token.grantVersion
        && get(accessPath()).data.role in ['admin', 'estimator'];
    }

    function isAdmin() {
      return hasPortalSession() && get(accessPath()).data.role == 'admin';
    }

    function validOwnedCreation(ownerField) {
      return hasPortalSession()
        && request.resource.data[ownerField] == request.auth.uid;
    }

    match /ssoAccess/{uid} {
      allow get: if hasV2RabClaim()
        && request.auth.uid == uid
        && resource.data.appId == 'rab-calc'
        && resource.data.centralUid == request.auth.token.centralUid
        && resource.data.grantVersion == request.auth.token.grantVersion;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if hasPortalSession() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /emailAllowlist/{emailId} {
      allow read, write: if false;
    }

    match /userInvites/{inviteId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read: if hasPortalSession();
      allow create, update, delete: if isAdmin();
    }

    match /priceItems/{itemId} {
      allow read: if hasPortalSession();
      allow create, update, delete: if isAdmin();
    }

    match /priceAuditEntries/{entryId} {
      allow read: if hasPortalSession();
      allow create: if isAdmin()
        && request.resource.data.editedBy is string
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if hasPortalSession();
      allow create: if hasPortalSession() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if hasPortalSession();
    }

    match /vendorEstimates/{vendorEstimateId} {
      allow read: if hasPortalSession();
      allow create: if hasPortalSession();
      allow update, delete: if hasPortalSession();
    }

    match /actualCosts/{estimateId} {
      allow read, create: if hasPortalSession();
      allow update: if hasPortalSession() && resource.data.status == 'draft';
      allow delete: if false;
    }

    match /paperCalculatorDrafts/{uid} {
      allow read, delete: if hasPortalSession() && request.auth.uid == uid;
      allow create, update: if validOwnedCreation('userId')
        && request.auth.uid == uid
        && request.resource.data.schemaVersion == 1;
    }

    match /paperCalculations/{calculationId} {
      allow read: if hasPortalSession();
      allow create: if validOwnedCreation('createdBy')
        && request.resource.data.schemaVersion == 1
        && request.resource.data.module in ['layout', 'book', 'plano', 'time'];
      allow update: if false;
      allow delete: if hasPortalSession()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /paperCustomSizes/{sizeId} {
      allow read: if hasPortalSession();
      allow create: if validOwnedCreation('createdBy')
        && request.resource.data.schemaVersion == 1
        && request.resource.data.type in ['paper', 'book', 'plano']
        && request.resource.data.width is number
        && request.resource.data.width > 0
        && request.resource.data.height is number
        && request.resource.data.height > 0;
      allow update: if hasPortalSession()
        && (resource.data.createdBy == request.auth.uid || isAdmin())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.schemaVersion == 1
        && request.resource.data.type in ['paper', 'book', 'plano']
        && request.resource.data.width is number
        && request.resource.data.width > 0
        && request.resource.data.height is number
        && request.resource.data.height > 0;
      allow delete: if hasPortalSession()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
